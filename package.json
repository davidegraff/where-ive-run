{
  "name": "where-ive-run",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.ts",
    "dev:web": "vite",
    "dev:server": "node --watch-path=server --watch-path=shared server/main.ts",
    "build": "npm run typecheck && vite build",
    "start": "node server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.222.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@zip.js/zip.js": "^2.25.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "maplibre-gl": "^5.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
