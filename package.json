{
  "name": "where-ive-run",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.ts",
    "dev:web": "vite",
    "dev:server": "uv run python -m server --reload",
    "gen:api": "uv run python -m server.typescript",
    "build": "npm run typecheck && vite build",
    "start": "uv run python -m server",
    "test": "uv run pytest && vitest run",
    "typecheck": "uv run python -m server.typescript --check && tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint:py": "uv run mypy"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "maplibre-gl": "^5.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
